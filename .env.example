# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# === PostgreSQL (contenedor) ===
POSTGRES_USER=pac
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=pac

# === Conexión de la aplicación a la base de datos ===
# El host 'postgres' es el nombre del servicio en docker-compose (red interna).
DATABASE_URL=postgresql://pac:cambia_esta_contrasena@postgres:5432/pac?schema=public

# === Backend (API) ===
PORT=3000

# === Worker (scheduler) ===
WORKER_INTERVALO_MS=30000

# === Producción (Caddy / dominio en Hostinger) ===
# Se define al desplegar. Ejemplo:
# DOMINIO=pac.tu-dominio.com

# === Secreto de cifrado del 2FA (se usará desde la Fase 4) ===
# Genera un valor fuerte en producción; este es solo un marcador.
CIFRADO_2FA_SECRET=define_un_secreto_fuerte_en_produccion
