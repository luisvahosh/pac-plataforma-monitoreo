# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real al repositorio (agrégalo a .gitignore).

# --- Entorno ---
NODE_ENV=production

# --- Base de datos PostgreSQL ---
DB_USER=pac_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_POR_UNA_SEGURA
DB_NAME=pac_db

# --- Backend ---
BACKEND_PORT=4000
# Puerto en el que el contenedor queda publicado en 127.0.0.1 del VPS;
# a este puerto es al que apunta el Nginx del host (ver nginx-pac.conf).
BACKEND_HOST_PORT=4005
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO

# --- Correo SMTP (para activación de cuenta, 2FA, recuperación de contraseña, alertas) ---
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp
SMTP_PASSWORD=tu-password-smtp

# --- Frontend ---
# Puerto en el que el contenedor queda publicado en 127.0.0.1 del VPS;
# a este puerto es al que apunta el Nginx del host (ver nginx-pac.conf).
FRONTEND_HOST_PORT=4006
# URL pública por la que el frontend llamará al backend (usar tu dominio real,
# apuntando al path /api/ que expone el Nginx del host)
PUBLIC_API_URL=https://pac.tudominio.com/api
