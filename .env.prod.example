# Plantilla de variables de PRODUCCIÓN (Hostinger). Copia a .env en el servidor
# y completa con valores reales y secretos fuertes. NUNCA subir .env al repo.

# === Dominio (Caddy / TLS automático) ===
DOMINIO=pac.tu-dominio.com

# === PostgreSQL ===
POSTGRES_USER=pac_admin
POSTGRES_PASSWORD=cambia_esto_por_un_secreto_fuerte
POSTGRES_DB=pac

# === Conexión de la app a la base de datos ===
# Recomendado en producción: usar el rol de aplicación de menor privilegio
# creado con infra/seguridad-bd.sql (pac_app), NO el usuario administrador.
DATABASE_URL=postgresql://pac_app:secreto_del_rol_app@postgres:5432/pac?schema=public

# === Backend ===
PORT=3000

# === Tokens de sesión (secretos fuertes y distintos) ===
JWT_ACCESS_SECRET=genera_un_secreto_largo_aleatorio
JWT_REFRESH_SECRET=genera_otro_secreto_largo_aleatorio
ACCESS_TOKEN_TTL=15m
RETO_2FA_TTL=5m
REFRESH_TOKEN_TTL_DIAS=7

# === Cifrado del secreto TOTP ===
CIFRADO_2FA_SECRET=genera_un_secreto_fuerte

# === Política de contraseñas y bloqueo ===
PASSWORD_MIN_LONGITUD=10
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# === Correo (Office 365 / Microsoft 365) ===
# dev = no envía correos reales | graph = Microsoft Graph API (recomendado) | smtp = SMTP autenticado
CORREO_MODO=graph
CORREO_REMITENTE=pac@tu-dominio.com

# --- CORREO_MODO=graph (recomendado) ---
MS_GRAPH_TENANT_ID=id_del_tenant
MS_GRAPH_CLIENT_ID=id_de_la_app_registrada
MS_GRAPH_CLIENT_SECRET=secreto_de_la_app_registrada
MS_GRAPH_SENDER=pac@tu-dominio.com

# --- CORREO_MODO=smtp (alternativa; falla si el tenant bloquea autenticación básica) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=pac@tu-dominio.com
SMTP_PASS=secreto_o_credencial_de_la_cuenta

# === URL pública (enlaces de correo) ===
APP_URL=https://pac.tu-dominio.com

# === Evidencias ===
EVIDENCIAS_DIR=/app/evidencias
EVIDENCIAS_MAX_MB=25
EVIDENCIAS_EXT=pdf,png,jpg,jpeg,gif,webp,docx,xlsx,pptx,txt,csv

# === CORS (normalmente vacío: frontend y API comparten origen tras Caddy) ===
# CORS_ORIGEN=https://pac.tu-dominio.com
