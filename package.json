{
  "name": "pac-plataforma-monitoreo",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de Seguimiento y Monitoreo del PAC de Medellín — andamiaje (Fase 2)",
  "workspaces": [
    "backend",
    "worker",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint \"{backend,worker,frontend}/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{backend,worker,frontend}/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{backend,worker,frontend}/src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0"
  }
}
