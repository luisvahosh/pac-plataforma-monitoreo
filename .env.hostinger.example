# Variables para el despliegue en Hostinger (docker-compose.hostinger.yml).
# Copia a .env y completa con valores reales y secretos fuertes.
# Genera secretos con:  openssl rand -base64 48

# === PostgreSQL ===
POSTGRES_USER=pac
POSTGRES_PASSWORD=CAMBIA_ESTE_SECRETO
POSTGRES_DB=pac

# === Conexión de la app (host 'postgres' = servicio del compose) ===
DATABASE_URL=postgresql://pac:CAMBIA_ESTE_SECRETO@postgres:5432/pac?schema=public

# === Puertos loopback (ajusta si otro proyecto ya los usa) ===
BACKEND_PORT=4005
FRONTEND_PORT=4006

# === Tokens de sesión (secretos fuertes y distintos) ===
JWT_ACCESS_SECRET=CAMBIA_secreto_access
JWT_REFRESH_SECRET=CAMBIA_secreto_refresh
ACCESS_TOKEN_TTL=15m
RETO_2FA_TTL=5m
REFRESH_TOKEN_TTL_DIAS=7

# === Cifrado del secreto TOTP (2FA) ===
CIFRADO_2FA_SECRET=CAMBIA_secreto_cifrado

# === Política de contraseñas y bloqueo ===
PASSWORD_MIN_LONGITUD=10
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# === Worker ===
WORKER_INTERVALO_MS=30000

# === Correo (Office 365) ===
# Empieza en 'dev' para validar sin enviar; cambia a 'smtp' cuando confirmes el tenant.
# dev = no envía correos reales | graph = Microsoft Graph API (recomendado) | smtp = SMTP autenticado
CORREO_MODO=dev
CORREO_REMITENTE=pac@tu-dominio.com

# --- CORREO_MODO=graph (recomendado) ---
# App registrada en Entra ID con permiso de aplicación Mail.Send + consentimiento
# de administrador. Ver docs/fase-13-despliegue/correo-microsoft-graph.md
MS_GRAPH_TENANT_ID=CAMBIA_tenant_id
MS_GRAPH_CLIENT_ID=CAMBIA_client_id
MS_GRAPH_CLIENT_SECRET=CAMBIA_client_secret
MS_GRAPH_SENDER=pac@tu-dominio.com

# --- CORREO_MODO=smtp (alternativa; falla si el tenant bloquea autenticación básica) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=pac@tu-dominio.com
SMTP_PASS=CAMBIA_credencial

# === URL pública (para enlaces de correo; debe ser tu dominio con https) ===
APP_URL=https://pac.tu-dominio.com

# === Evidencias ===
EVIDENCIAS_MAX_MB=25
EVIDENCIAS_EXT=pdf,png,jpg,jpeg,gif,webp,docx,xlsx,pptx,txt,csv
