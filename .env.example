# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# === PostgreSQL (contenedor) ===
POSTGRES_USER=pac
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=pac

# === Conexión de la aplicación a la base de datos ===
# El host 'postgres' es el nombre del servicio en docker-compose (red interna).
DATABASE_URL=postgresql://pac:cambia_esta_contrasena@postgres:5432/pac?schema=public

# === Backend (API) ===
PORT=3000

# === Worker (scheduler) ===
WORKER_INTERVALO_MS=30000

# === Producción (Caddy / dominio en Hostinger) ===
# Se define al desplegar. Ejemplo:
# DOMINIO=pac.tu-dominio.com

# === Secreto de cifrado del 2FA (Fase 4) — clave para cifrar el secreto TOTP ===
# Genera un valor fuerte en producción; este es solo un marcador.
CIFRADO_2FA_SECRET=define_un_secreto_fuerte_en_produccion

# === Tokens de sesión (Fase 4) ===
JWT_ACCESS_SECRET=define_un_secreto_de_access_token
JWT_REFRESH_SECRET=define_un_secreto_de_refresh_token
ACCESS_TOKEN_TTL=15m
RETO_2FA_TTL=5m
REFRESH_TOKEN_TTL_DIAS=7

# === Política de contraseñas (PA-18; parametrizable) ===
PASSWORD_MIN_LONGITUD=10

# === Bloqueo por intentos fallidos (Fase 4) ===
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# === Correo (Fase 4) ===
# CORREO_MODO=dev  -> no envía correos reales (los registra en consola).
# CORREO_MODO=smtp -> usa Office 365 / Microsoft 365 por SMTP autenticado.
CORREO_MODO=dev
CORREO_REMITENTE=pac@tu-dominio.com
# Solo para CORREO_MODO=smtp (Office 365):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=pac@tu-dominio.com
SMTP_PASS=define_la_contrasena_o_secreto
# URL pública de la app para los enlaces de activación/recuperación:
APP_URL=http://localhost

# === Evidencias (Fase 6) ===
# Directorio de almacenamiento (montado como volumen Docker; NUNCA público).
EVIDENCIAS_DIR=/app/evidencias
# Tamaño máximo por archivo en MB (PA-05):
EVIDENCIAS_MAX_MB=25
# Lista blanca de extensiones permitidas (separadas por coma, PA-05):
EVIDENCIAS_EXT=pdf,png,jpg,jpeg,gif,webp,docx,xlsx,pptx,txt,csv
