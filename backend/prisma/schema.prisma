// Esquema Prisma — andamiaje Fase 2.
// El modelo de dominio real (Proyecto, Fase, Actividad, Hito, Línea Base,
// Avance, Evidencia, Usuario, Auditoría, etc.) se implementa desde la Fase 3,
// siguiendo docs/fase-1-arquitectura/02-modelo-datos.md.
// Por ahora solo una tabla mínima para tener una migración inicial reproducible.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id       Int      @id @default(autoincrement())
  clave    String   @unique
  valor    String
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("app_meta")
}

// ─── Dominio (Fase 3) ───────────────────────────────────────────────
// Proyecto → Fase → Actividad → Hito (RN-01). El Estado de la Actividad
// NO se almacena: se deriva en consulta (ver src/dominio/estado-actividad.ts).

model Proyecto {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String?
  objetivos   String?
  fechaInicio DateTime? @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  creadoEn    DateTime  @default(now()) @map("creado_en")
  fases       Fase[]

  @@map("proyecto")
}

model Fase {
  id             String      @id @default(uuid())
  proyectoId     String      @map("proyecto_id")
  nombre         String
  descripcion    String?
  pesoPorcentaje Float       @default(0) @map("peso_porcentaje") // aporte al Proyecto; el conjunto suma 100
  orden          Int         @default(0)
  proyecto       Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  actividades    Actividad[]

  @@map("fase")
}

model Actividad {
  id                  String       @id @default(uuid())
  faseId              String       @map("fase_id")
  nombre              String
  descripcion         String?
  fechaInicioPlan     DateTime?    @map("fecha_inicio_plan") // línea base vigente
  fechaFinPlan        DateTime?    @map("fecha_fin_plan") // línea base vigente
  finalizada          Boolean      @default(false)
  avancePorcentaje    Float        @default(0) @map("avance_porcentaje") // 0..100 (derivado de los avances, ponderado por peso)
  tramoPago           String?      @map("tramo_pago") // p.ej. "Pago 2", "Pago 3", "Pago 4"
  tramoPagoPorcentaje Float?       @map("tramo_pago_porcentaje") // % del contrato asociado a ese tramo
  fase                Fase         @relation(fields: [faseId], references: [id], onDelete: Cascade)
  hitos               Hito[]
  asignaciones        Asignacion[]
  avances             Avance[]
  evidencias          Evidencia[]

  // Dependencias entre entregables (p.ej. P9 depende de P6 y P14).
  dependeDe       DependenciaActividad[] @relation("ActividadDependiente")
  esDependenciaDe DependenciaActividad[] @relation("ActividadOrigen")

  // Subactividades (tareas del entregable, cuando el entregable las trae
  // desglosadas). Si una Actividad tiene subactividades, su avancePorcentaje
  // se calcula como el promedio de ellas en vez de reportarse directamente.
  subactividades Subactividad[]
  notas          Nota[]

  @@map("actividad")
}

// Relación "A depende de B": A no puede considerarse listo/entregable sin B.
model DependenciaActividad {
  id          String    @id @default(uuid())
  actividadId String    @map("actividad_id") // la que depende
  dependeDeId String    @map("depende_de_id") // la actividad de la que depende
  actividad   Actividad @relation("ActividadDependiente", fields: [actividadId], references: [id], onDelete: Cascade)
  dependeDe   Actividad @relation("ActividadOrigen", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@unique([actividadId, dependeDeId])
  @@map("dependencia_actividad")
}

model Hito {
  id            String    @id @default(uuid())
  actividadId   String    @map("actividad_id")
  nombre        String
  fechaObjetivo DateTime? @map("fecha_objetivo") // línea base vigente
  cumplido      Boolean   @default(false)
  actividad     Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@map("hito")
}

// Historial INMUTABLE de cambios de Línea Base (RN-07). La fecha original
// nunca se sobrescribe. usuarioId será FK a Usuario a partir de la Fase 4.
model CambioLineaBase {
  id              String    @id @default(uuid())
  entidadTipo     String    @map("entidad_tipo") // 'actividad' | 'hito'
  entidadId       String    @map("entidad_id")
  campo           String // 'fecha_inicio' | 'fecha_fin' | 'fecha_objetivo'
  fechaOriginal   DateTime? @map("fecha_original")
  fechaNueva      DateTime? @map("fecha_nueva")
  usuarioId       String?   @map("usuario_id")
  usuario         Usuario?  @relation(fields: [usuarioId], references: [id])
  justificacion   String
  fechaHoraCambio DateTime  @default(now()) @map("fecha_hora_cambio")

  @@index([entidadTipo, entidadId])
  @@map("cambio_linea_base")
}

// ─── Autenticación y usuarios (Fase 4) ──────────────────────────────

model Rol {
  id       String    @id @default(uuid())
  nombre   String    @unique // 'administrador' | 'colaborador'
  usuarios Usuario[]

  @@map("rol")
}

model Usuario {
  id                String    @id @default(uuid())
  rolId             String    @map("rol_id")
  nombre            String
  email             String    @unique
  celular           String?
  passwordHash      String?   @map("password_hash") // Argon2id; nunca texto plano
  totpSecretCifrado String?   @map("totp_secret_cifrado") // AES-GCM en reposo
  totpHabilitado    Boolean   @default(false) @map("totp_habilitado")
  estado            String    @default("pendiente_activacion") // pendiente_activacion | activo | inactivo
  intentosFallidos  Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta    DateTime? @map("bloqueado_hasta")
  creadoEn          DateTime  @default(now()) @map("creado_en")

  rol              Rol               @relation(fields: [rolId], references: [id])
  tokens           TokenCuenta[]
  refreshTokens    RefreshToken[]
  cambiosLineaBase CambioLineaBase[]
  asignaciones     Asignacion[]
  avances          Avance[]
  avancesSubactividad AvanceSubactividad[]
  evidencias       Evidencia[]
  notas            Nota[]

  @@map("usuario")
}

model TokenCuenta {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tipo      String // 'activacion' | 'recuperacion'
  tokenHash String   @map("token_hash") // SHA-256 del token; el token en claro solo va por correo
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@map("token_cuenta")
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tokenHash String   @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_token")
}

// ─── Asignación y avances (Fase 5) ──────────────────────────────────

// Un Colaborador asignado a una Actividad, con su peso de trabajo (RN-08).
// La suma de pesos por Actividad debe ser 100 %.
model Asignacion {
  id                    String    @id @default(uuid())
  actividadId           String    @map("actividad_id")
  usuarioId             String    @map("usuario_id")
  pesoTrabajoPorcentaje Float     @map("peso_trabajo_porcentaje")
  creadoEn              DateTime  @default(now()) @map("creado_en")
  actividad             Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([actividadId, usuarioId])
  @@map("asignacion")
}

// Registro histórico (append-only) de avances. Puede subir o bajar (RN-05);
// nunca se sobrescribe. Trazado con autor y fecha/hora.
model Avance {
  id            String    @id @default(uuid())
  actividadId   String    @map("actividad_id")
  usuarioId     String    @map("usuario_id")
  porcentaje    Float // 0..100
  observaciones String?
  fechaHora     DateTime    @default(now()) @map("fecha_hora")
  actividad     Actividad   @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  evidencias    Evidencia[]

  @@index([actividadId, usuarioId])
  @@map("avance")
}

// Tarea puntual dentro de una Actividad (p.ej. cada viñeta de "Tareas
// principales" de un entregable). avancePorcentaje es un caché del último
// AvanceSubactividad registrado; ver AvanceSubactividad para el histórico.
model Subactividad {
  id               String               @id @default(uuid())
  actividadId      String               @map("actividad_id")
  descripcion      String
  orden            Int                  @default(0)
  avancePorcentaje Float                @default(0) @map("avance_porcentaje")
  actividad        Actividad            @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  avances          AvanceSubactividad[]

  @@map("subactividad")
}

// Registro histórico (append-only) de avances de una Subactividad, igual que
// Avance (RN-05): puede subir o bajar, nunca se sobrescribe. La evidencia de
// una subactividad es siempre un enlace (no adjuntos), guardado junto al
// avance que la aporta.
model AvanceSubactividad {
  id              String       @id @default(uuid())
  subactividadId  String       @map("subactividad_id")
  usuarioId       String       @map("usuario_id")
  porcentaje      Float
  enlaceEvidencia String?      @map("enlace_evidencia")
  observaciones   String?
  fechaHora       DateTime     @default(now()) @map("fecha_hora")
  subactividad    Subactividad @relation(fields: [subactividadId], references: [id], onDelete: Cascade)
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([subactividadId, usuarioId])
  @@map("avance_subactividad")
}

// Pendiente/nota de seguimiento (pestaña pública "Pendientes y notas").
// "Pendiente" y "nota" son la misma entidad; `resuelta` distingue si ya se
// atendió. Puede ser general del proyecto (actividadId nulo) o ligada a una
// actividad puntual. Lectura pública; solo un usuario autenticado la crea,
// la marca resuelta o la elimina.
model Nota {
  id          String     @id @default(uuid())
  actividadId String?    @map("actividad_id")
  autorId     String     @map("autor_id")
  texto       String
  resuelta    Boolean    @default(false)
  creadoEn    DateTime   @default(now()) @map("creado_en")
  actividad   Actividad? @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  autor       Usuario    @relation(fields: [autorId], references: [id])

  @@index([actividadId])
  @@map("nota")
}

// ─── Auditoría (Fase 8) ─────────────────────────────────────────────
// Registro append-only e inmutable (RN-17, RN-18): sin endpoints de
// modificación/borrado. En producción se revoca UPDATE/DELETE al rol de
// aplicación sobre esta tabla (ver README / Fase 13).
model EventoAuditoria {
  id          String   @id @default(uuid())
  usuarioId   String?  @map("usuario_id")
  accion      String // crear | editar | eliminar | acceso_sensible | login
  entidadTipo String?  @map("entidad_tipo")
  entidadId   String?  @map("entidad_id")
  detalle     Json?
  ip          String?
  fechaHora   DateTime @default(now()) @map("fecha_hora")

  @@index([usuarioId])
  @@index([entidadTipo, entidadId])
  @@index([fechaHora])
  @@map("evento_auditoria")
}

// ─── Notificaciones y alertas (Fase 7) ─────────────────────────────

// Configuración de anticipación de las Alertas de vencimiento (RN-03b, PA-08/12).
model ReglaAlerta {
  id               String   @id @default(uuid())
  ambito           String   @default("global")
  diasAnticipacion Int[]    @map("dias_anticipacion") // p. ej. [7, 3, 1]
  activo           Boolean  @default(true)
  actualizadoEn    DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@map("regla_alerta")
}

// Registro de notificaciones enviadas, para evitar duplicados (RN-11) y auditar.
model NotificacionEnviada {
  id          String   @id @default(uuid())
  tipo        String // activacion | recuperacion | proxima_a_vencer | vencida | confirmacion_avance | cambio_importante
  usuarioId   String?  @map("usuario_id")
  entidadTipo String?  @map("entidad_tipo")
  entidadId   String?  @map("entidad_id")
  umbralDias  Int?     @map("umbral_dias")
  fechaHora   DateTime @default(now()) @map("fecha_hora")

  @@index([tipo, entidadId, usuarioId])
  @@map("notificacion_enviada")
}

// ─── Evidencias (Fase 6) ────────────────────────────────────────────
// El CONTENIDO/enlace de toda Evidencia es privado (RN-06, RN-13): nunca
// accesible sin autenticación. Se sirve solo por endpoint autenticado.
model Evidencia {
  id            String     @id @default(uuid())
  actividadId   String     @map("actividad_id")
  avanceId      String?    @map("avance_id")
  autorId       String     @map("autor_id")
  tipo          String // enlace | imagen | archivo | documento | observacion
  url           String? // solo tipo enlace
  archivoRef    String?    @map("archivo_ref") // nombre del archivo en el volumen; NUNCA público
  nombreArchivo String?    @map("nombre_archivo")
  mime          String?
  tamanoBytes   Int?       @map("tamano_bytes")
  checksum      String? // SHA-256 para integridad
  observacion   String?
  fechaHora     DateTime   @default(now()) @map("fecha_hora")
  actividad     Actividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  avance        Avance?    @relation(fields: [avanceId], references: [id], onDelete: SetNull)
  autor         Usuario    @relation(fields: [autorId], references: [id])

  @@index([actividadId])
  @@map("evidencia")
}
