// Esquema Prisma — andamiaje Fase 2.
// El modelo de dominio real (Proyecto, Fase, Actividad, Hito, Línea Base,
// Avance, Evidencia, Usuario, Auditoría, etc.) se implementa desde la Fase 3,
// siguiendo docs/fase-1-arquitectura/02-modelo-datos.md.
// Por ahora solo una tabla mínima para tener una migración inicial reproducible.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id       Int      @id @default(autoincrement())
  clave    String   @unique
  valor    String
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("app_meta")
}

// ─── Dominio (Fase 3) ───────────────────────────────────────────────
// Proyecto → Fase → Actividad → Hito (RN-01). El Estado de la Actividad
// NO se almacena: se deriva en consulta (ver src/dominio/estado-actividad.ts).

model Proyecto {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String?
  objetivos   String?
  fechaInicio DateTime? @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  creadoEn    DateTime  @default(now()) @map("creado_en")
  fases       Fase[]
  actas       Acta[]

  @@map("proyecto")
}

model Fase {
  id                     String                 @id @default(uuid())
  proyectoId             String                 @map("proyecto_id")
  nombre                 String
  descripcion            String?
  pesoPorcentaje         Float                  @default(0) @map("peso_porcentaje") // aporte al Proyecto; el conjunto suma 100
  orden                  Int                    @default(0)
  proyecto               Proyecto               @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  actividades            Actividad[]
  asignacionesComponente AsignacionComponente[]

  @@map("fase")
}

model Actividad {
  id                  String       @id @default(uuid())
  faseId              String       @map("fase_id")
  nombre              String
  descripcion         String?
  fechaInicioPlan     DateTime?    @map("fecha_inicio_plan") // línea base vigente
  fechaFinPlan        DateTime?    @map("fecha_fin_plan") // línea base vigente
  finalizada          Boolean      @default(false)
  avancePorcentaje    Float        @default(0) @map("avance_porcentaje") // 0..100 (derivado de los avances, ponderado por peso)
  tramoPago           String?      @map("tramo_pago") // p.ej. "Pago 2", "Pago 3", "Pago 4"
  tramoPagoPorcentaje Float?       @map("tramo_pago_porcentaje") // % del contrato asociado a ese tramo
  fase                Fase         @relation(fields: [faseId], references: [id], onDelete: Cascade)
  hitos               Hito[]
  asignaciones        Asignacion[]
  avances             Avance[]
  evidencias          Evidencia[]

  // Dependencias entre entregables (p.ej. P9 depende de P6 y P14).
  dependeDe       DependenciaActividad[] @relation("ActividadDependiente")
  esDependenciaDe DependenciaActividad[] @relation("ActividadOrigen")

  // Subactividades (tareas del entregable, cuando el entregable las trae
  // desglosadas). Si una Actividad tiene subactividades, su avancePorcentaje
  // se calcula como el promedio de ellas en vez de reportarse directamente.
  subactividades Subactividad[]

  @@map("actividad")
}

// Relación "A depende de B": A no puede considerarse listo/entregable sin B.
model DependenciaActividad {
  id          String    @id @default(uuid())
  actividadId String    @map("actividad_id") // la que depende
  dependeDeId String    @map("depende_de_id") // la actividad de la que depende
  actividad   Actividad @relation("ActividadDependiente", fields: [actividadId], references: [id], onDelete: Cascade)
  dependeDe   Actividad @relation("ActividadOrigen", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@unique([actividadId, dependeDeId])
  @@map("dependencia_actividad")
}

model Hito {
  id            String    @id @default(uuid())
  actividadId   String    @map("actividad_id")
  nombre        String
  fechaObjetivo DateTime? @map("fecha_objetivo") // línea base vigente
  cumplido      Boolean   @default(false)
  actividad     Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@map("hito")
}

// Historial INMUTABLE de cambios de Línea Base (RN-07). La fecha original
// nunca se sobrescribe. usuarioId será FK a Usuario a partir de la Fase 4.
model CambioLineaBase {
  id              String    @id @default(uuid())
  entidadTipo     String    @map("entidad_tipo") // 'actividad' | 'hito'
  entidadId       String    @map("entidad_id")
  campo           String // 'fecha_inicio' | 'fecha_fin' | 'fecha_objetivo'
  fechaOriginal   DateTime? @map("fecha_original")
  fechaNueva      DateTime? @map("fecha_nueva")
  usuarioId       String?   @map("usuario_id")
  usuario         Usuario?  @relation(fields: [usuarioId], references: [id])
  justificacion   String
  fechaHoraCambio DateTime  @default(now()) @map("fecha_hora_cambio")

  @@index([entidadTipo, entidadId])
  @@map("cambio_linea_base")
}

// ─── Autenticación y usuarios (Fase 4) ──────────────────────────────

model Rol {
  id       String    @id @default(uuid())
  nombre   String    @unique // 'administrador' | 'colaborador'
  usuarios Usuario[]

  @@map("rol")
}

model Usuario {
  id                String    @id @default(uuid())
  rolId             String    @map("rol_id")
  nombre            String
  email             String    @unique
  celular           String?
  passwordHash      String?   @map("password_hash") // Argon2id; nunca texto plano
  totpSecretCifrado String?   @map("totp_secret_cifrado") // AES-GCM en reposo
  totpHabilitado    Boolean   @default(false) @map("totp_habilitado")
  estado            String    @default("pendiente_activacion") // pendiente_activacion | activo | inactivo
  intentosFallidos  Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta    DateTime? @map("bloqueado_hasta")
  creadoEn          DateTime  @default(now()) @map("creado_en")

  rol                      Rol                      @relation(fields: [rolId], references: [id])
  tokens                   TokenCuenta[]
  refreshTokens            RefreshToken[]
  cambiosLineaBase         CambioLineaBase[]
  asignaciones             Asignacion[]
  asignacionesComponente   AsignacionComponente[]
  asignacionesSubactividad AsignacionSubactividad[]
  avances                  Avance[]
  avancesSubactividad      AvanceSubactividad[]
  evidencias               Evidencia[]

  // Gestión de Actas (Fase 15)
  tareas             Tarea[]
  avancesTarea       AvanceTarea[]
  riesgosResponsable Riesgo[]
  asistencias        ActaAsistente[]
  actaDocumentos     ActaDocumento[]

  @@map("usuario")
}

model TokenCuenta {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tipo      String // 'activacion' | 'recuperacion'
  tokenHash String   @map("token_hash") // SHA-256 del token; el token en claro solo va por correo
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@map("token_cuenta")
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tokenHash String   @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_token")
}

// ─── Asignación y avances (Fase 5) ──────────────────────────────────

// Un Colaborador asignado a una Actividad, con su peso de trabajo (RN-08).
// La suma de pesos por Actividad debe ser 100 %.
model Asignacion {
  id                    String    @id @default(uuid())
  actividadId           String    @map("actividad_id")
  usuarioId             String    @map("usuario_id")
  pesoTrabajoPorcentaje Float     @map("peso_trabajo_porcentaje")
  creadoEn              DateTime  @default(now()) @map("creado_en")
  actividad             Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([actividadId, usuarioId])
  @@map("asignacion")
}

// Registro histórico (append-only) de avances. Puede subir o bajar (RN-05);
// nunca se sobrescribe. Trazado con autor y fecha/hora.
model Avance {
  id            String      @id @default(uuid())
  actividadId   String      @map("actividad_id")
  usuarioId     String      @map("usuario_id")
  porcentaje    Float // 0..100
  observaciones String?
  fechaHora     DateTime    @default(now()) @map("fecha_hora")
  actividad     Actividad   @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  evidencias    Evidencia[]

  @@index([actividadId, usuarioId])
  @@map("avance")
}

// Tarea puntual dentro de una Actividad (p.ej. cada viñeta de "Tareas
// principales" de un entregable). avancePorcentaje es un caché del último
// AvanceSubactividad registrado; ver AvanceSubactividad para el histórico.
model Subactividad {
  id                String                   @id @default(uuid())
  actividadId       String                   @map("actividad_id")
  codigo            String? // p.ej. "P1-A01" (identidad estable para la siembra idempotente)
  etapa             String? // "Elaboración" | "Revisión y aval" | "Revisión final Secretaría"
  descripcion       String
  orden             Int                      @default(0)
  // Peso de la Subactividad (Actividad, en el lenguaje del negocio) dentro de
  // su Entregable. La suma por Entregable es 100 %. El avance del Entregable
  // (Actividad de la BD) se deriva como la SUMA PONDERADA por este peso.
  pesoPorcentaje    Float                    @default(0) @map("peso_porcentaje")
  fechaInicioPlan   DateTime?                @map("fecha_inicio_plan")
  fechaFinPlan      DateTime?                @map("fecha_fin_plan")
  criterioTerminado String?                  @map("criterio_terminado")
  nota              String? // apoyos/roles no vinculados a una cuenta (texto libre)
  // Riesgos asociados a la Actividad (texto libre). Se REGISTRA solo desde la
  // parte privada (autenticado, ver PATCH subactividades/:id/riesgos) y se
  // MUESTRA públicamente en el dashboard "Ejecutar Plan" (RN sin evidencia).
  riesgos           String?
  avancePorcentaje  Float                    @default(0) @map("avance_porcentaje")
  actividad         Actividad                @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  avances           AvanceSubactividad[]
  asignaciones      AsignacionSubactividad[]

  // Gestión de Actas (Fase 15): Tareas (nivel 4, opcionales) que apoyan el
  // desarrollo de esta Actividad, y riesgos estructurados asociados.
  tareas               Tarea[]
  riesgosEstructurados Riesgo[]

  @@map("subactividad")
}

// Distribución de responsabilidad de un Componente (Fase) entre sus
// Colaboradores: cada uno con su porcentaje de participación; el conjunto por
// Componente suma 100 % (RN-08 a nivel de Componente). Es INFORMATIVA — no
// altera el cálculo del avance (que se deriva de las Actividades) — y permite
// ver de forma consolidada quién participa en el Componente y en qué
// proporción. Al incorporar un nuevo Colaborador se redistribuyen los pesos.
model AsignacionComponente {
  id             String   @id @default(uuid())
  faseId         String   @map("fase_id")
  usuarioId      String   @map("usuario_id")
  pesoPorcentaje Float    @map("peso_porcentaje")
  creadoEn       DateTime @default(now()) @map("creado_en")
  fase           Fase     @relation(fields: [faseId], references: [id], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([faseId, usuarioId])
  @@map("asignacion_componente")
}

// El responsable real del trabajo es quien ejecuta la Subactividad (RN-08
// aplicado a ese nivel): un Colaborador asignado a una Subactividad, con su
// peso relativo frente a los demás responsables de esa misma subactividad.
// Es informativo ("quién responde por esta tarea y en qué proporción"); no
// participa en el cálculo del avance (ver AvanceSubactividad).
model AsignacionSubactividad {
  id                    String       @id @default(uuid())
  subactividadId        String       @map("subactividad_id")
  usuarioId             String       @map("usuario_id")
  pesoTrabajoPorcentaje Float        @map("peso_trabajo_porcentaje")
  creadoEn              DateTime     @default(now()) @map("creado_en")
  subactividad          Subactividad @relation(fields: [subactividadId], references: [id], onDelete: Cascade)
  usuario               Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([subactividadId, usuarioId])
  @@map("asignacion_subactividad")
}

// Registro histórico (append-only) de avances de una Subactividad, igual que
// Avance (RN-05): puede subir o bajar, nunca se sobrescribe. La evidencia de
// una subactividad es siempre un enlace (no adjuntos), guardado junto al
// avance que la aporta.
model AvanceSubactividad {
  id              String       @id @default(uuid())
  subactividadId  String       @map("subactividad_id")
  usuarioId       String       @map("usuario_id")
  porcentaje      Float
  enlaceEvidencia String?      @map("enlace_evidencia")
  observaciones   String?
  fechaHora       DateTime     @default(now()) @map("fecha_hora")
  subactividad    Subactividad @relation(fields: [subactividadId], references: [id], onDelete: Cascade)
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([subactividadId, usuarioId])
  @@map("avance_subactividad")
}

// ─── Auditoría (Fase 8) ─────────────────────────────────────────────
// Registro append-only e inmutable (RN-17, RN-18): sin endpoints de
// modificación/borrado. En producción se revoca UPDATE/DELETE al rol de
// aplicación sobre esta tabla (ver README / Fase 13).
model EventoAuditoria {
  id          String   @id @default(uuid())
  usuarioId   String?  @map("usuario_id")
  accion      String // crear | editar | eliminar | acceso_sensible | login
  entidadTipo String?  @map("entidad_tipo")
  entidadId   String?  @map("entidad_id")
  detalle     Json?
  ip          String?
  fechaHora   DateTime @default(now()) @map("fecha_hora")

  @@index([usuarioId])
  @@index([entidadTipo, entidadId])
  @@index([fechaHora])
  @@map("evento_auditoria")
}

// ─── Notificaciones y alertas (Fase 7) ─────────────────────────────

// Configuración de anticipación de las Alertas de vencimiento (RN-03b, PA-08/12).
model ReglaAlerta {
  id               String   @id @default(uuid())
  ambito           String   @default("global")
  diasAnticipacion Int[]    @map("dias_anticipacion") // p. ej. [7, 3, 1]
  activo           Boolean  @default(true)
  actualizadoEn    DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@map("regla_alerta")
}

// Registro de notificaciones enviadas, para evitar duplicados (RN-11) y auditar.
model NotificacionEnviada {
  id          String   @id @default(uuid())
  tipo        String // activacion | recuperacion | proxima_a_vencer | vencida | confirmacion_avance | cambio_importante
  usuarioId   String?  @map("usuario_id")
  entidadTipo String?  @map("entidad_tipo")
  entidadId   String?  @map("entidad_id")
  umbralDias  Int?     @map("umbral_dias")
  fechaHora   DateTime @default(now()) @map("fecha_hora")

  @@index([tipo, entidadId, usuarioId])
  @@map("notificacion_enviada")
}

// ─── Evidencias (Fase 6) ────────────────────────────────────────────
// El CONTENIDO/enlace de toda Evidencia es privado (RN-06, RN-13): nunca
// accesible sin autenticación. Se sirve solo por endpoint autenticado.
model Evidencia {
  id            String    @id @default(uuid())
  actividadId   String    @map("actividad_id")
  avanceId      String?   @map("avance_id")
  autorId       String    @map("autor_id")
  tipo          String // enlace | imagen | archivo | documento | observacion
  url           String? // solo tipo enlace
  archivoRef    String?   @map("archivo_ref") // nombre del archivo en el volumen; NUNCA público
  nombreArchivo String?   @map("nombre_archivo")
  mime          String?
  tamanoBytes   Int?      @map("tamano_bytes")
  checksum      String? // SHA-256 para integridad
  observacion   String?
  fechaHora     DateTime  @default(now()) @map("fecha_hora")
  actividad     Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  avance        Avance?   @relation(fields: [avanceId], references: [id], onDelete: SetNull)
  autor         Usuario   @relation(fields: [autorId], references: [id])

  @@index([actividadId])
  @@map("evidencia")
}

// ─── Gestión de Actas (Fase 15) ─────────────────────────────────────
// Documenta las reuniones de seguimiento y, desde ellas, amplía el seguimiento
// del proyecto (Tareas nivel 4 y riesgos). No duplica entidades ni el motor de
// avance. Solo Administrador crea/gestiona actas; el público solo ve las
// 'enviada' (sin documentos anexos).

model Acta {
  id            String    @id @default(uuid())
  proyectoId    String    @map("proyecto_id")
  numero        Int // correlativo por proyecto
  fecha         DateTime
  lugar         String?
  horaInicio    String?   @map("hora_inicio")
  horaFin       String?   @map("hora_fin")
  actividadTema String?   @map("actividad_tema") // "Actividad o tema" (FO-GINF-102)
  objetivo      String?
  elaboradoPor  String?   @map("elaborado_por") // texto libre (FO-GINF-102)
  convocadaPor  String?   @map("convocada_por")
  estado        String    @default("borrador") // borrador | enviada
  enviadaEn     DateTime? @map("enviada_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  proyecto      Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  asistentes    ActaAsistente[]
  temas         ActaTema[]
  conclusiones  ActaConclusion[]
  documentos    ActaDocumento[]
  tareas        Tarea[]
  riesgosOrigen Riesgo[]         @relation("RiesgoActaOrigen")

  @@unique([proyectoId, numero])
  @@map("acta")
}

// Asistentes al acta: colaboradores del sistema (usuarioId) O invitados externos
// (texto libre, sin cuenta). Uno de los dos por fila.
model ActaAsistente {
  id           String   @id @default(uuid())
  actaId       String   @map("acta_id")
  usuarioId    String?  @map("usuario_id") // asistente que ES usuario del sistema
  nombre       String? // requerido si es invitado externo (sin usuarioId)
  organizacion String? // opcional, para invitados (empresa/entidad)
  rolEnReunion String?  @map("rol_en_reunion") // convocado | invitado | responsable
  esInvitado   Boolean  @default(false) @map("es_invitado")
  acta         Acta     @relation(fields: [actaId], references: [id], onDelete: Cascade)
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([actaId])
  @@map("acta_asistente")
}

// Tarea (nivel 4, Fase 15): apoya el desarrollo de una Actividad (BD
// Subactividad, nivel 3). Es OPCIONAL: una actividad se puede desarrollar
// directamente o desglosarse en Tareas. Cuando hay Tareas, el avance de la
// actividad se deriva de ellas (roll-up). El peso es % absoluto de la actividad
// y la suma por colaborador no puede superar su ponderado de asignación
// (RN-ACTA-06). Cada Tarea la ejecuta un colaborador responsable.
model Tarea {
  id               String        @id @default(uuid())
  subactividadId   String        @map("subactividad_id") // actividad nivel 3
  actaOrigenId     String?       @map("acta_origen_id") // acta donde nació
  usuarioId        String        @map("usuario_id") // responsable (1 colaborador)
  nombre           String
  descripcion      String?
  pesoPorcentaje   Float         @default(0) @map("peso_porcentaje")
  fechaCompromiso  DateTime?     @map("fecha_compromiso")
  estado           String        @default("pendiente") // pendiente | en_ejecucion | finalizada
  avancePorcentaje Float         @default(0) @map("avance_porcentaje") // caché del último avance
  observaciones    String?
  creadoEn         DateTime      @default(now()) @map("creado_en")
  subactividad     Subactividad  @relation(fields: [subactividadId], references: [id], onDelete: Cascade)
  actaOrigen       Acta?         @relation(fields: [actaOrigenId], references: [id], onDelete: SetNull)
  usuario          Usuario       @relation(fields: [usuarioId], references: [id])
  avances          AvanceTarea[]

  @@index([subactividadId, usuarioId])
  @@map("tarea")
}

// Histórico append-only de avances de una Tarea (RN-05).
model AvanceTarea {
  id              String   @id @default(uuid())
  tareaId         String   @map("tarea_id")
  usuarioId       String   @map("usuario_id")
  porcentaje      Float
  enlaceEvidencia String?  @map("enlace_evidencia")
  observaciones   String?
  fechaHora       DateTime @default(now()) @map("fecha_hora")
  tarea           Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([tareaId, usuarioId])
  @@map("avance_tarea")
}

// Riesgo por actividad (nivel 3). Los 'abierto' se arrastran a la siguiente acta.
model Riesgo {
  id              String                @id @default(uuid())
  subactividadId  String                @map("subactividad_id") // actividad nivel 3
  actaOrigenId    String?               @map("acta_origen_id")
  descripcion     String
  probabilidad    String? // alta | media | baja
  impacto         String? // alto | medio | bajo
  nivel           String? // alto | medio | bajo
  estado          String                @default("abierto") // abierto | mitigado | cerrado
  responsableId   String?               @map("responsable_id")
  mitigacion      String?
  observaciones   String?
  creadoEn        DateTime              @default(now()) @map("creado_en")
  actualizadoEn   DateTime              @default(now()) @updatedAt @map("actualizado_en")
  subactividad    Subactividad          @relation(fields: [subactividadId], references: [id], onDelete: Cascade)
  actaOrigen      Acta?                 @relation("RiesgoActaOrigen", fields: [actaOrigenId], references: [id], onDelete: SetNull)
  responsable     Usuario?              @relation(fields: [responsableId], references: [id])
  actualizaciones RiesgoActualizacion[]

  @@index([subactividadId, estado])
  @@map("riesgo")
}

// Histórico de cambios de un riesgo (qué se revisó en cada acta). actaId es un
// puntero blando (sin FK) al acta donde se hizo la actualización.
model RiesgoActualizacion {
  id           String   @id @default(uuid())
  riesgoId     String   @map("riesgo_id")
  actaId       String?  @map("acta_id")
  estado       String?
  probabilidad String?
  impacto      String?
  nivel        String?
  nota         String?
  fechaHora    DateTime @default(now()) @map("fecha_hora")
  riesgo       Riesgo   @relation(fields: [riesgoId], references: [id], onDelete: Cascade)

  @@index([riesgoId])
  @@map("riesgo_actualizacion")
}

// Desarrollo temático del acta. actividadId/subactividadId son punteros blandos
// (sin FK) a la actividad/entregable relacionado.
model ActaTema {
  id             String  @id @default(uuid())
  actaId         String  @map("acta_id")
  actividadId    String? @map("actividad_id")
  subactividadId String? @map("subactividad_id")
  tema           String
  descripcion    String?
  decisiones     String?
  observaciones  String?
  orden          Int     @default(0)
  acta           Acta    @relation(fields: [actaId], references: [id], onDelete: Cascade)

  @@index([actaId])
  @@map("acta_tema")
}

model ActaConclusion {
  id     String @id @default(uuid())
  actaId String @map("acta_id")
  texto  String
  orden  Int    @default(0)
  acta   Acta   @relation(fields: [actaId], references: [id], onDelete: Cascade)

  @@index([actaId])
  @@map("acta_conclusion")
}

// Documento anexo — PRIVADO (nunca público). Reutiliza el patrón de Evidencia
// (archivo en volumen, servido solo autenticado).
model ActaDocumento {
  id            String   @id @default(uuid())
  actaId        String   @map("acta_id")
  autorId       String   @map("autor_id")
  tipo          String // enlace | archivo | documento
  url           String?
  archivoRef    String?  @map("archivo_ref")
  nombreArchivo String?  @map("nombre_archivo")
  mime          String?
  tamanoBytes   Int?     @map("tamano_bytes")
  checksum      String?
  fechaHora     DateTime @default(now()) @map("fecha_hora")
  acta          Acta     @relation(fields: [actaId], references: [id], onDelete: Cascade)
  autor         Usuario  @relation(fields: [autorId], references: [id])

  @@index([actaId])
  @@map("acta_documento")
}
